<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Favorites and the contacts tab read the on-device address book. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The Recents tab shows the device call history. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Dialing places the call directly, like the stock app. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Short tick on keypad presses. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Carrier message-waiting indicator drives the voicemail badge. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonoPhone">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open with a number prefilled when another app asks to dial. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
